# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Opcional para conectar banco de dados e autenticação na nuvem.
# Pode também ser preenchido diretamente na tela de Configurações do app.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# STRIPE CONFIGURATION
# Chave pública usada no frontend (começa com pk_test_ ou pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_suaChavePublica"

# Chave secreta usada nas Edge Functions / backend (começa com sk_test_ ou sk_live_)
STRIPE_SECRET_KEY="sk_test_suaChaveSecreta"

# Segredo do Webhook do Stripe (começa com whsec_)
STRIPE_WEBHOOK_SECRET="whsec_seuSegredoWebhook"

# IDs dos Preços Recorrentes cadastrados no Stripe
VITE_STRIPE_PRICE_INDIVIDUAL="price_individual_27"
VITE_STRIPE_PRICE_INTERMEDIARIO="price_intermediario_47"
VITE_STRIPE_PRICE_PROFISSIONAL="price_profissional_97"
