# URL pública do frontend (Netlify)
VITE_APP_URL="https://aluguelfacil.netlify.app"

# SUPABASE: banco de dados e autenticação.
# Também pode ser preenchido pela tela de Configurações do app.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# DEMO: "true" força o modo demonstração mesmo com o Supabase configurado.
# Sem Supabase configurado, o app entra em demonstração automaticamente.
VITE_DEMO_MODE="false"

# TESTE DE ISOLAMENTO RLS (apenas scripts locais; nunca use no frontend)
# O script test:rls usa VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY + a chave abaixo.
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# STRIPE CONFIGURATION
# Chave pública usada no frontend (começa com pk_test_ ou pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_suaChavePublica"

# Chave secreta usada nas Edge Functions / backend (começa com sk_test_ ou sk_live_)
STRIPE_SECRET_KEY="sk_test_suaChaveSecreta"

# Segredo do Webhook do Stripe (começa com whsec_)
STRIPE_WEBHOOK_SECRET="whsec_seuSegredoWebhook"

# IDs dos Preços Recorrentes cadastrados no Stripe
VITE_STRIPE_PRICE_INDIVIDUAL="price_individual_27"
VITE_STRIPE_PRICE_INTERMEDIARIO="price_intermediario_47"
VITE_STRIPE_PRICE_PROFISSIONAL="price_profissional_97"

# IDs dos Preços no backend (Edge Functions). Configure via `supabase secrets set`.
STRIPE_PRICE_INDIVIDUAL="price_individual_27"
STRIPE_PRICE_INTERMEDIARIO="price_intermediario_47"
STRIPE_PRICE_PROFISSIONAL="price_profissional_97"

# Alternativa ao VITE_DEMO_MODE: no navegador, defina
# localStorage.setItem('ALUGUEL_FACIL_FORCE_DEMO', 'true') para forçar o modo demo.
